rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isPharmacy() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pharmacy';
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
          && request.resource.data.role == 'customer';
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create, update: if isOwner(storeId) && isPharmacy();
      allow delete: if isOwner(storeId) && isPharmacy();
    }

    match /storeProducts/{productId} {
      allow read: if true;
      allow create, update: if isPharmacy()
        && request.resource.data.storeId == request.auth.uid;
      allow delete: if isPharmacy() && resource.data.storeId == request.auth.uid;
    }

    match /carts/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /products/{productId} {
      allow read, delete: if isPharmacy() && resource.data.ownerId == request.auth.uid;
      allow create: if isPharmacy() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isPharmacy()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /suppliers/{supplierId} {
      allow read, delete: if isPharmacy() && resource.data.ownerId == request.auth.uid;
      allow create: if isPharmacy() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isPharmacy()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /customers/{customerId} {
      allow read, delete: if isPharmacy() && resource.data.ownerId == request.auth.uid;
      allow create: if isPharmacy() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isPharmacy()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isPharmacy());
      allow update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
